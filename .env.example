# Safe template only. Run scripts/setup-local.ps1 to create private local secrets.
ASPNETCORE_ENVIRONMENT=Development
PORT=5012
# ==============================================================================
# DATABASE CONFIGURATION
# Cấu hình chuẩn dùng chung Neon PostgreSQL Cloud (Khuyên dùng cho cả nhóm):
# ==============================================================================
Database__Provider=Postgres
Database__AutoMigrate=false
Database__SeedDemoData=false
Database__AllowInMemoryFallback=false

# Neon PostgreSQL Cloud Connection String:
ConnectionStrings__DefaultConnection=Host=YOUR_NEON_HOST;Database=neondb;Username=YOUR_NEON_USER;Password=YOUR_NEON_PASSWORD;SSL Mode=VerifyFull;Channel Binding=Require

# Tùy chọn chạy PostgreSQL Local qua Docker (chỉ bật khi cần phát triển offline độc lập):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=event_ticket_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=event_ticket_db;Username=postgres;Password=YOUR_LOCAL_PASSWORD

# Redis Configuration (nếu chạy local thì để localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379
SmtpSettings__Server=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__SenderName=EventPulse Ticketing
SmtpSettings__SenderEmail=your-gmail@gmail.com
SmtpSettings__Username=your-gmail@gmail.com
SmtpSettings__Password=CHANGE_ME_GMAIL_APP_PASSWORD
JWT_KEY=YOUR_LONG_RANDOM_JWT_SECRET
Jwt__Issuer=EventTicketBooking.Api
Jwt__Audience=EventTicketBooking.Client
Jwt__ExpiresInHours=24

# ==============================================================================
# PAYMENT CONFIGURATION (Story S-18 / S-19 / Tasks T-40, T-44)
# Provider: "Mock" (Mặc định cho local/development) hoặc "PayOS" (Cổng sandbox/thật)
# ==============================================================================
PAYMENT_PROVIDER=Mock
Payment__PayOS__ClientId=YOUR_PAYOS_CLIENT_ID
Payment__PayOS__ApiKey=YOUR_PAYOS_API_KEY
Payment__PayOS__ChecksumKey=YOUR_PAYOS_CHECKSUM_KEY
Payment__PayOS__BaseUrl=https://api-merchant.payos.vn
Payment__PayOS__ReturnUrl=http://localhost:5012/payment-result.html
Payment__PayOS__CancelUrl=http://localhost:5012/payment-result.html
