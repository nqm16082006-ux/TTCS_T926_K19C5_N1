# Safe template only. Run scripts/setup-local.ps1 to create private local secrets.
ASPNETCORE_ENVIRONMENT=Development
PORT=5012
# ==============================================================================
# DATABASE CONFIGURATION
# Cách 1 (Khuyên dùng cho cả nhóm): Dùng chung PostgreSQL Cloud (Neon.tech / Supabase / Render)
# Chỉ cần dán chuỗi ConnectionString vào đây, cả nhóm sẽ dùng chung dữ liệu realtime:
# ConnectionStrings__DefaultConnection=Host=ep-xxx.ap-southeast-1.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
#
# Cách 2: Dùng PostgreSQL Local qua Docker
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=event_ticket_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=event_ticket_db;Username=postgres;Password=postgres_password_123

# Redis Configuration (nếu chạy local thì để localhost:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
ConnectionStrings__Redis=localhost:6379
SmtpSettings__Server=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__SenderName=EventPulse Ticketing
SmtpSettings__SenderEmail=your-gmail@gmail.com
SmtpSettings__Username=your-gmail@gmail.com
SmtpSettings__Password=CHANGE_ME_GMAIL_APP_PASSWORD
JWT_KEY=CHANGE_ME_JWT_KEY
Jwt__Issuer=EventTicketBooking.Api
Jwt__Audience=EventTicketBooking.Client
Jwt__ExpiresInHours=24
